{
    "name": "Mzurihealth",
    "version": "2.1.3",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "start-open": "ng serve --open",
        "start-aot": "ng serve --aot",
        "start-hmr": "ng serve --configuration hmr --source-map=false --hmr-warning=false",
        "start-hmr-sourcemaps": "ng serve --configuration hmr --source-map=true --hmr-warning=false",
        "build": "ng build ",
        "build-stats": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --dev --stats-json",
        "build-prod": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --prod",
        "build-prod-stats": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --prod --stats-json",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "bundle-report": "webpack-bundle-analyzer  ./stitch/hosting/files/stats.json ",
        "stitch-deploy": "cd stitch/ && stitch-cli import --strategy=merge -y",
        "stitch-deploy-hosting": "cd stitch/ && stitch-cli import --strategy=merge --include-hosting -y",
        "build-stitch-deploy-hosting": " ng build --prod && cd stitch/ && stitch-cli import --strategy=merge --include-hosting -y"
    },
    "private": true,
    "dependencies": {
        "@agm/core": "1.0.0-beta.6",
        "@angular/animations": "^8.1.0",
        "@angular/cdk": "^8.0.2",
        "@angular/common": "^8.1.0",
        "@angular/compiler": "^8.1.0",
        "@angular/core": "^8.1.0",
        "@angular/flex-layout": "8.0.0-beta.26",
        "@angular/forms": "^8.1.0",
        "@angular/material": "^8.0.2",
        "@angular/platform-browser": "^8.1.0",
        "@angular/platform-browser-dynamic": "^8.1.0",
        "@angular/pwa": "0.803.0",
        "@angular/router": "^8.1.0",
        "@angular/service-worker": "^8.1.0",
        "@ngx-translate/core": "11.0.1",
        "@swimlane/ngx-datatable": "^15.0.2",
        "@types/bson": "4.0.1",
        "@types/prismjs": "1.16.0",
        "angular": "1.7.9",
        "angular-calendar": "^0.27.12",
        "angulartics2": "7.5.2",
        "date-fns": "1.30.1",
        "hammerjs": "2.0.8",
        "howler": "2.1.2",
        "lodash": "^4.17.13",
        "moment": "2.24.0",
        "ngx-color-picker": "^8.0.1",
        "mongodb-stitch-browser-sdk": "4.7.1",
        "ngx-strongly-typed-forms": "8.0.1",
        "perfect-scrollbar": "1.4.0",
        "prismjs": "1.16.0",
        "rxjs": "6.5.2",
        "tslib": "1.10.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^0.801.0",
        "@angular/cli": "^8.0.3",
        "@angular/compiler-cli": "^8.1.0",
        "@angular/language-service": "^8.1.0",
        "@angularclass/hmr": "^2.1.3",
        "@types/jasmine": "3.3.13",
        "@types/jasminewd2": "~2.0.3",
        "@types/node": "^12.6.2",
        "codelyzer": "5.1.0",
        "core-js": "3.1.4",
        "ngx-cookie-service": "2.2.0",
        "perfect-scrollbar": "1.4.0",
        "protractor": "~5.4.0",
        "ts-node": "^8.3.0",
        "tslib": "1.10.0",
        "tslint": "^5.18.0",
        "typescript": "~3.4.3",
        "webpack-bundle-analyzer": "^3.6.0",
        "zone.js": "0.10.2"
    }
}
